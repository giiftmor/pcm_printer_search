{
  "manifest_version": 3,
  "name": "PCM Compass",
  "version": "2.3.2",
  "description": "Quick access to NWU PCM IT Service Desk tools",
  "author": "PCM IT Service Desk",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "permissions": ["tabs", "storage"],
  "host_permissions": [
    "*://*.nwu.ac.za/*",
    "http://localhost:5000/*",
    "http://196.252.15.214:5000/*"
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
