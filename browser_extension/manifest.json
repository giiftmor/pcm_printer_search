{
  "manifest_version": 3,
  "name": "NWU Quick Links",
  "version": "1.1.0",
  "description": "Quick access to NWU SVPC, IDM profiles, and Printer Data Search",
  "author": "Neo Moruri & Claude",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "permissions": [
    "tabs",
    "activeTab"
  ],
  "host_permissions": [
    "*://*.nwu.ac.za/*",
    "http://localhost:5000/*",
    "http://localhost:*/*",
    "http://196.252.43.75:5000/*"
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
